{
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
    "Referrer-Policy": "no-referrer",
    "X-Content-Type-Options": "nosniff",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=(self)"
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  },
  "routes": [
    {
      "route": "/demo",
      "rewrite": "/index.html"
    },
    {
      "route": "/privacy",
      "rewrite": "/index.html"
    },
    {
      "route": "/terms",
      "rewrite": "/index.html"
    },
    {
      "route": "/assets/*",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/icons/*",
      "headers": { "Cache-Control": "public, max-age=604800" }
    },
    {
      "route": "/sw.js",
      "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" }
    },
    {
      "route": "/manifest.webmanifest",
      "headers": { "Cache-Control": "no-cache" }
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  }
}
